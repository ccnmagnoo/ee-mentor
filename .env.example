# EE Mentor · variables de entorno
# Copia este archivo a `.env` y ajusta los valores según tu instalación.

# Directorio raíz de datos (TOML, Markdown). Por defecto: ./data
# EE_DATA_DIR=D:/Dev/ee-mentor/data

# Carpeta con los HTML históricos de mentorías usados por la biblioteca.
# Por defecto: ./casos
# EE_KNOWLEDGE_DIR=D:/Dev/ee-mentor/casos

# Nombre del asesor que se propone por defecto en nuevas visitas.
# EE_ASSESSOR_NAME=Consultor Energético
