---
import Icon from '@/components/ui/Icon.astro';
import {
  CATEGORIAS,
  DIFICULTADES,
  ENERGOS,
  IMPACTOS,
  INVERSIONES,
  PRIORIDADES,
  type Categoria,
  type Hallazgo,
  type Recomendacion,
} from '@/lib/schemas';

interface Props {
  tipo: 'hallazgo' | 'recomendacion';
  action: string;
  item?: Hallazgo | Recomendacion | null;
  cancelHref?: string;
  recomendaciones?: Recomendacion[];
}

const {
  tipo,
  action,
  item = null,
  cancelHref = '/catalogos',
  recomendaciones = [],
} = Astro.props;
const esHallazgo = tipo === 'hallazgo';
const hallazgo = esHallazgo ? (item as Hallazgo | null) : null;
const recomendacion = !esHallazgo ? (item as Recomendacion | null) : null;

const titulo = esHallazgo ? 'hallazgo' : 'recomendación';
const codigo = item?.codigo ?? '';
const tituloItem = item?.titulo ?? '';
const categoria: Categoria = item?.categoria ?? 'iluminacion';
const descripcion = item?.descripcion ?? '';
const energetico = item?.energetico ?? 'electricidad';
const tags = (item?.tags ?? []).join(', ');
const activo = item?.activo ?? true;
const origen = item?.origen ?? 'catalogo_base';
const editando = Boolean(item);

const prioridadPeso = { alta: 3, media: 2, baja: 1 } as const;

const recoVinculadaId = hallazgo?.recomendacion_id ?? '';
const recosDisponibles = recomendaciones
  .filter((reco) => reco.activo || reco.id === recoVinculadaId)
  .map((reco) => ({
    reco,
    afinidad:
      (reco.categoria === categoria ? 4 : 0) +
      (reco.energetico === energetico ? 2 : 0) +
      (prioridadPeso[reco.prioridad] ?? 0),
  }))
  .sort(
    (a, b) =>
      b.afinidad - a.afinidad || a.reco.titulo.localeCompare(b.reco.titulo, 'es'),
  );

const recoSugerida =
  recosDisponibles.find(({ reco }) => reco.categoria === categoria)?.reco ?? null;
const recoSeleccionadaId = recoVinculadaId || (!editando && recoSugerida ? recoSugerida.id : '');

const plazos = [
  'Corto plazo (1-3 meses)',
  'Mediano plazo (3-6 meses)',
  'Largo plazo (6-12 meses)',
  'Continuo / permanente',
];
---

<form action={action} method="post" data-api class="space-y-5">
  <div data-form-error class="hidden"></div>

  {item && <input type="hidden" name="id" value={item.id} />}
  <input type="hidden" name="origen" value={origen} />

  <section class="card overflow-hidden">
    <div class="section-heading">
      <span class="step-number">{esHallazgo ? 'H' : 'R'}</span>
      <div>
        <h2 class="fieldset-title">{editando ? `Editar ${titulo}` : `Nuevo ${titulo}`}</h2>
        <p class="text-xs text-slate-500">
          El código identifica el ítem en el catálogo y aparece en los informes generados.
        </p>
      </div>
    </div>
    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
      <div>
        <label class="label" for="codigo">Código *</label>
        <input
          id="codigo"
          name="codigo"
          class="input font-mono uppercase"
          required
          minlength="2"
          value={codigo}
          placeholder={esHallazgo ? 'HAL-ILUM-99' : 'REC-ILUM-99'}
        />
        <p class="help">Se normaliza automáticamente para construir el identificador del archivo.</p>
      </div>
      <div>
        <label class="label" for="categoria">Tipo de uso tecnológico *</label>
        <select id="categoria" name="categoria" class="input" required>
          {Object.entries(CATEGORIAS).map(([key, label]) => (
            <option value={key} selected={categoria === key}>{label}</option>
          ))}
        </select>
        <p class="help">Agrupa el hallazgo por tecnología o uso final y guía la recomendación sugerida.</p>
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="titulo">Título *</label>
        <input id="titulo" name="titulo" class="input" required minlength="3" value={tituloItem} />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="descripcion">Descripción *</label>
        <textarea id="descripcion" name="descripcion" rows="4" class="input" required minlength="10">{descripcion}</textarea>
        <p class="help">Explica el problema o la medida con suficiente detalle para reutilizarla en terreno.</p>
      </div>
      <div>
        <label class="label" for="energetico">Energético asociado</label>
        <select id="energetico" name="energetico" class="input">
          {Object.entries(ENERGOS).map(([key, label]) => (
            <option value={key} selected={energetico === key}>{label}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="label" for="tags">Etiquetas</label>
        <input id="tags" name="tags" class="input" value={tags} placeholder="separadas, por, coma" />
        <p class="help">Ayudan a buscar y agrupar ítems relacionados.</p>
      </div>
    </div>
  </section>

  {esHallazgo ? (
    <section class="card overflow-hidden">
      <div class="section-heading">
        <span class="step-number">2</span>
        <div>
          <h2 class="fieldset-title">Clasificación del hallazgo</h2>
          <p class="text-xs text-slate-500">Impacto, justificación técnica y recomendación vinculada.</p>
        </div>
      </div>
      <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
        <div>
          <label class="label" for="impacto">Impacto *</label>
          <select id="impacto" name="impacto" class="input" required>
            {Object.entries(IMPACTOS).map(([key, label]) => (
              <option value={key} selected={(hallazgo?.impacto ?? 'medio') === key}>{label}</option>
            ))}
          </select>
        </div>
        <div class="rounded-lg border border-brand-200 bg-brand-50/50 px-3 py-2">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-brand-700">Vínculo automático</p>
          <p class="mt-0.5 text-xs leading-relaxed text-slate-600">
            La recomendación sugerida combina el uso tecnológico y el energético del hallazgo.
          </p>
        </div>
        <div class="sm:col-span-2" data-reco-picker data-autoselect={!editando ? 'true' : undefined}>
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p class="label">Recomendación vinculada</p>
              <p class="help -mt-0.5">
                Se preselecciona según el tipo de uso tecnológico y el energético. Puedes cambiarla o dejarla sin vínculo.
              </p>
            </div>
            <button
              type="button"
              class:list={[
                'btn-secondary btn-sm',
                (!recoSugerida || recoSeleccionadaId === recoSugerida.id) && 'hidden',
              ]}
              data-reco-apply
            >
              <Icon name="sparkles" size={14} /> Usar sugerida
            </button>
          </div>

          {recosDisponibles.length > 0 ? (
            <>
              <p class="help" data-reco-hint>
                {recoSugerida
                  ? `Sugerida: ${recoSugerida.titulo}`
                  : 'No hay una recomendación de la misma categoría; elige una manualmente.'}
              </p>

              <label class="relative mt-2 block">
                <span class="sr-only">Buscar recomendación</span>
                <Icon name="search" size={16} class="pointer-events-none absolute left-3 top-2.5 text-slate-400" />
                <input
                  type="search"
                  class="input pl-9"
                  placeholder="Buscar por título, categoría, energético o ahorro…"
                  data-filter-target="#reco-picker-list"
                />
              </label>

              <div
                id="reco-picker-list"
                data-reco-list
                class="mt-2 max-h-80 space-y-2 overflow-y-auto rounded-lg border border-slate-200 bg-slate-50/50 p-2"
                role="radiogroup"
                aria-label="Recomendación vinculada"
              >
                <label
                  data-filter-item
                  data-reco-item
                  data-reco-id=""
                  data-reco-categoria=""
                  data-reco-energetico=""
                  data-reco-prioridad=""
                  data-reco-titulo="Sin recomendación vinculada"
                  class="finding-card flex cursor-pointer items-start gap-3"
                >
                  <input
                    type="radio"
                    name="recomendacion_id"
                    value=""
                    class="radio mt-0.5"
                    checked={!recoSeleccionadaId}
                    data-reco-input
                  />
                  <span class="min-w-0">
                    <span class="block text-sm font-medium text-slate-800">Sin recomendación vinculada</span>
                    <span class="block text-xs text-slate-500">El hallazgo se registrará sin una medida asociada.</span>
                  </span>
                </label>

                {recosDisponibles.map(({ reco }) => {
                  const esSugerida = recoSugerida?.id === reco.id;
                  return (
                    <label
                      data-filter-item
                      data-reco-item
                      data-reco-id={reco.id}
                      data-reco-categoria={reco.categoria}
                      data-reco-energetico={reco.energetico}
                      data-reco-prioridad={reco.prioridad}
                      data-reco-titulo={reco.titulo}
                      class="finding-card flex cursor-pointer items-start gap-3"
                    >
                      <input
                        type="radio"
                        name="recomendacion_id"
                        value={reco.id}
                        class="radio mt-0.5"
                        checked={recoSeleccionadaId === reco.id}
                        data-reco-input
                      />
                      <span class="min-w-0 flex-1">
                        <span class="flex flex-wrap items-center gap-1.5">
                          <span class:list={['badge-brand', !esSugerida && 'hidden']} data-reco-suggested>
                            <Icon name="sparkles" size={11} /> Sugerida
                          </span>
                          <span class="badge-neutral">{CATEGORIAS[reco.categoria]}</span>
                          <span class="badge-neutral">{ENERGOS[reco.energetico]}</span>
                          <span class="badge-neutral">{INVERSIONES[reco.inversion]}</span>
                          {!reco.activo && <span class="badge-rose">Inactiva</span>}
                          <span class="ml-auto font-mono text-[10px] font-semibold text-slate-400">{reco.codigo}</span>
                        </span>
                        <span class="mt-1 block text-sm font-medium text-slate-800">{reco.titulo}</span>
                        <span class="mt-0.5 block text-xs leading-relaxed text-slate-500">{reco.descripcion}</span>
                        {reco.ahorro_estimado && (
                          <span class="mt-1 block text-xs font-medium text-emerald-700">
                            Ahorro estimado: {reco.ahorro_estimado}
                          </span>
                        )}
                      </span>
                    </label>
                  );
                })}
              </div>
              <p class="help hidden" data-reco-empty>No hay recomendaciones que coincidan con la búsqueda.</p>
            </>
          ) : (
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
              No hay recomendaciones activas en el catálogo. Crea una recomendación para poder vincularla.
            </p>
          )}
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="justificacion">Justificación técnica</label>
          <textarea id="justificacion" name="justificacion" rows="3" class="input">{hallazgo?.justificacion ?? ''}</textarea>
          <p class="help">Fundamento normativo o técnico que respalda el hallazgo.</p>
        </div>
      </div>
    </section>
  ) : (
    <section class="card overflow-hidden">
      <div class="section-heading">
        <span class="step-number">2</span>
        <div>
          <h2 class="fieldset-title">Clasificación de la recomendación</h2>
          <p class="text-xs text-slate-500">Inversión, complejidad, prioridad y ahorro esperado.</p>
        </div>
      </div>
      <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
        <div>
          <label class="label" for="inversion">Inversión *</label>
          <select id="inversion" name="inversion" class="input" required>
            {Object.entries(INVERSIONES).map(([key, label]) => (
              <option value={key} selected={(recomendacion?.inversion ?? 'media') === key}>{label}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="dificultad">Dificultad de implementación *</label>
          <select id="dificultad" name="dificultad" class="input" required>
            {Object.entries(DIFICULTADES).map(([key, label]) => (
              <option value={key} selected={(recomendacion?.dificultad ?? 'media') === key}>{label}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="prioridad">Prioridad *</label>
          <select id="prioridad" name="prioridad" class="input" required>
            {Object.entries(PRIORIDADES).map(([key, label]) => (
              <option value={key} selected={(recomendacion?.prioridad ?? 'media') === key}>{label}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="plazo">Plazo de implementación</label>
          <select id="plazo" name="plazo" class="input">
            {plazos.map((plazo) => (
              <option value={plazo} selected={(recomendacion?.plazo ?? plazos[0]) === plazo}>{plazo}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="ahorro_estimado">Ahorro estimado</label>
          <input
            id="ahorro_estimado"
            name="ahorro_estimado"
            class="input"
            value={recomendacion?.ahorro_estimado ?? ''}
            placeholder="Ej: 10-20% del consumo de iluminación"
          />
        </div>
        <div>
          <label class="label" for="hallazgos_relacionados">Hallazgos relacionados</label>
          <input
            id="hallazgos_relacionados"
            name="hallazgos_relacionados"
            class="input font-mono uppercase"
            value={(recomendacion?.hallazgos_relacionados ?? []).join(', ')}
            placeholder="HAL-ILUM-01, HAL-ILUM-02"
          />
          <p class="help">Códigos separados por coma.</p>
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="beneficio">Beneficio esperado</label>
          <textarea id="beneficio" name="beneficio" rows="3" class="input">{recomendacion?.beneficio ?? ''}</textarea>
        </div>
      </div>
    </section>
  )}

  <section class="card card-pad">
    <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
      <input type="checkbox" name="activo" class="checkbox" checked={activo} />
      Ítem activo (disponible para seleccionar en visitas)
    </label>
  </section>

  <div class="flex flex-wrap items-center justify-end gap-2">
    <a href={cancelHref} class="btn-secondary">Cancelar</a>
    <button type="submit" class="btn-primary">
      <Icon name="check" size={16} />
      {editando ? 'Guardar cambios' : `Crear ${titulo}`}
    </button>
  </div>
</form>
