---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  tone?: 'brand' | 'amber' | 'rose' | 'sky' | 'slate';
}
const { label, value, hint, tone = 'brand' } = Astro.props;
const tones = {
  brand: 'bg-brand-50 text-brand-700 ring-brand-100',
  amber: 'bg-amber-50 text-amber-700 ring-amber-100',
  rose: 'bg-rose-50 text-rose-700 ring-rose-100',
  sky: 'bg-sky-50 text-sky-700 ring-sky-100',
  slate: 'bg-slate-100 text-slate-600 ring-slate-200',
};
---

<div class="card card-pad">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{label}</p>
      <p class="kpi mt-2">{value}</p>
      {hint && <p class="mt-1 text-xs text-slate-500">{hint}</p>}
    </div>
    <span class={`flex h-10 w-10 items-center justify-center rounded-xl ring-1 ring-inset ${tones[tone]}`}>
      <slot name="icon" />
    </span>
  </div>
</div>
