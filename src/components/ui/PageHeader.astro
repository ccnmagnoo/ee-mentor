---
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  breadcrumbs?: Breadcrumb[];
}
const { title, eyebrow, subtitle, breadcrumbs = [] } = Astro.props;
---

<header class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
  <div class="min-w-0">
    {breadcrumbs.length > 0 && (
      <nav class="mb-2 flex flex-wrap items-center gap-1.5 text-xs text-slate-500" aria-label="Ruta de navegación">
        {breadcrumbs.map((crumb, index) => (
          <span class="flex items-center gap-1.5">
            {index > 0 && <span class="text-slate-300">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-brand-700">{crumb.label}</a>
            ) : (
              <span class="text-slate-500">{crumb.label}</span>
            )}
          </span>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow mb-1.5">{eyebrow}</p>}
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-[28px]">{title}</h1>
    {subtitle && <p class="mt-1.5 max-w-3xl text-sm leading-relaxed text-slate-500">{subtitle}</p>}
  </div>
  <div class="flex shrink-0 flex-wrap items-center gap-2">
    <slot name="actions" />
  </div>
</header>
