---
import Icon from '@/components/ui/Icon.astro';
import { REGION_DEFAULT } from '@/lib/config';
import type { Empresa } from '@/lib/schemas';
import {
  ESTADOS_SISTEMA_FV,
  RUBROS,
  TIPOS_CONEXION_FV,
} from '@/lib/schemas';
import { urlMapa } from '@/lib/ubicacion';

interface Props {
  action: string;
  empresa?: Empresa | null;
  submitLabel?: string;
  cancelHref?: string;
}
const { action, empresa = null, submitLabel = 'Guardar empresa', cancelHref = '/empresas' } = Astro.props;
const mapaActual = empresa ? urlMapa(empresa) : null;
const fv = empresa?.sistema_fotovoltaico;
---

<form action={action} method="post" data-api class="space-y-5">
  <div data-form-error class="hidden"></div>

  <section class="card overflow-hidden">
    <div class="section-heading">
      <span class="step-number">1</span>
      <div>
        <h2 class="fieldset-title">Identificación del negocio</h2>
        <p class="text-xs text-slate-500">Datos que aparecerán en la portada y el encabezado del informe.</p>
      </div>
    </div>
    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
      <div class="sm:col-span-2">
        <label class="label" for="nombre">Nombre de la empresa *</label>
        <input id="nombre" name="nombre" class="input" required minlength="2" value={empresa?.nombre ?? ''} placeholder="Ej: Café Aurora" />
      </div>
      <div>
        <label class="label" for="rut">RUT</label>
        <input id="rut" name="rut" class="input" value={empresa?.rut ?? ''} placeholder="76.482.193-5" />
      </div>
      <div>
        <label class="label" for="rubro">Rubro</label>
        <select id="rubro" name="rubro" class="input">
          {RUBROS.map((rubro) => (
            <option value={rubro} selected={(empresa?.rubro ?? 'Cafetería') === rubro}>{rubro}</option>
          ))}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="direccion">Dirección</label>
        <input id="direccion" name="direccion" class="input" value={empresa?.direccion ?? ''} placeholder="Calle, número, local" />
      </div>
      <div>
        <label class="label" for="comuna">Comuna</label>
        <input id="comuna" name="comuna" class="input" value={empresa?.comuna ?? ''} placeholder="Viña del Mar" />
      </div>
      <div>
        <label class="label" for="region">Región</label>
        <input id="region" name="region" class="input" value={empresa?.region ?? REGION_DEFAULT} />
      </div>

      <div class="sm:col-span-2 border-t border-slate-100 pt-1">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Georreferenciación (opcional)</p>
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="mapa_url">Enlace de ubicación</label>
        <input
          id="mapa_url"
          name="mapa_url"
          type="url"
          class="input"
          value={empresa?.mapa_url ?? ''}
          placeholder="https://maps.app.goo.gl/..."
        />
        <p class="mt-1 text-xs text-slate-500">
          Pega el enlace de Google Maps u otro servicio de mapas. Si el enlace contiene coordenadas, se completan automáticamente.
        </p>
        {mapaActual && (
          <a
            href={mapaActual}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-brand-700 hover:text-brand-800"
          >
            Abrir ubicación actual
          </a>
        )}
      </div>
      <div>
        <label class="label" for="latitud">Latitud</label>
        <input
          id="latitud"
          name="latitud"
          type="number"
          step="any"
          min="-90"
          max="90"
          inputmode="decimal"
          class="input"
          value={empresa?.latitud ?? ''}
          placeholder="-33.02450"
        />
      </div>
      <div>
        <label class="label" for="longitud">Longitud</label>
        <input
          id="longitud"
          name="longitud"
          type="number"
          step="any"
          min="-180"
          max="180"
          inputmode="decimal"
          class="input"
          value={empresa?.longitud ?? ''}
          placeholder="-71.55180"
        />
      </div>
      <div class="sm:col-span-2">
        <p class="text-xs text-slate-500">
          Coordenadas en grados decimales (WGS84). Ingresa latitud y longitud juntas para permitir la georreferenciación posterior.
        </p>
      </div>
    </div>
  </section>

  <section class="card overflow-hidden">
    <div class="section-heading">
      <span class="step-number">2</span>
      <div>
        <h2 class="fieldset-title">Contacto y operación</h2>
        <p class="text-xs text-slate-500">Información útil para coordinar visitas y contextualizar el diagnóstico.</p>
      </div>
    </div>
    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
      <div>
        <label class="label" for="contacto">Persona de contacto</label>
        <input id="contacto" name="contacto" class="input" value={empresa?.contacto ?? ''} />
      </div>
      <div>
        <label class="label" for="telefono">Teléfono</label>
        <input id="telefono" name="telefono" class="input" value={empresa?.telefono ?? ''} placeholder="+56 9 ..." />
      </div>
      <div>
        <label class="label" for="correo">Correo electrónico</label>
        <input id="correo" name="correo" type="email" class="input" value={empresa?.correo ?? ''} />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label" for="trabajadores">Trabajadores</label>
          <input id="trabajadores" name="trabajadores" type="number" min="0" step="1" class="input" value={empresa?.trabajadores ?? 0} />
        </div>
        <div>
          <label class="label" for="superficie_m2">Superficie (m²)</label>
          <input id="superficie_m2" name="superficie_m2" type="number" min="0" step="0.1" class="input" value={empresa?.superficie_m2 ?? 0} />
        </div>
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="observaciones">Observaciones generales</label>
        <textarea id="observaciones" name="observaciones" rows="3" class="input" placeholder="Horarios, particularidades de la operación, antecedentes relevantes…">{empresa?.observaciones ?? ''}</textarea>
      </div>
    </div>
  </section>

  <section class="card overflow-hidden">
    <div class="section-heading">
      <span class="step-number">3</span>
      <div>
        <h2 class="fieldset-title">Sistema fotovoltaico</h2>
        <p class="text-xs text-slate-500">Datos del proyecto o instalación para dimensionar y evaluar su aporte energético.</p>
      </div>
    </div>
    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6">
      <div>
        <label class="label" for="fv_estado">Estado</label>
        <select id="fv_estado" name="sistema_fotovoltaico.estado" class="input">
          {Object.entries(ESTADOS_SISTEMA_FV).map(([key, label]) => (
            <option value={key} selected={(fv?.estado ?? 'no_aplica') === key}>{label}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="label" for="fv_proveedor">Proveedor / instalador</label>
        <input id="fv_proveedor" name="sistema_fotovoltaico.proveedor" class="input" value={fv?.proveedor ?? ''} placeholder="Ej: Solari Energía" />
      </div>
      <div>
        <label class="label" for="fv_paneles">Cantidad de paneles</label>
        <input id="fv_paneles" name="sistema_fotovoltaico.paneles" type="number" min="0" step="1" class="input" value={fv?.paneles ?? 0} />
      </div>
      <div>
        <label class="label" for="fv_fecha">Fecha de instalación</label>
        <input id="fv_fecha" name="sistema_fotovoltaico.fecha_instalacion" type="date" class="input" value={fv?.fecha_instalacion ?? ''} />
      </div>
      <div>
        <label class="label" for="fv_potencia">Potencia considerada (kWp)</label>
        <input id="fv_potencia" name="sistema_fotovoltaico.potencia_kwp" type="number" min="0" step="0.01" class="input" value={fv?.potencia_kwp ?? 0} />
        <p class="help">Valor central usado en las estimaciones del informe.</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label" for="fv_min">Potencia mínima (kWp)</label>
          <input id="fv_min" name="sistema_fotovoltaico.potencia_kwp_min" type="number" min="0" step="0.01" class="input" value={fv?.potencia_kwp_min ?? 0} />
        </div>
        <div>
          <label class="label" for="fv_max">Potencia máxima (kWp)</label>
          <input id="fv_max" name="sistema_fotovoltaico.potencia_kwp_max" type="number" min="0" step="0.01" class="input" value={fv?.potencia_kwp_max ?? 0} />
        </div>
      </div>
      <div>
        <label class="label" for="fv_conexion">Tipo de conexión</label>
        <select id="fv_conexion" name="sistema_fotovoltaico.tipo_conexion" class="input">
          {Object.entries(TIPOS_CONEXION_FV).map(([key, label]) => (
            <option value={key} selected={(fv?.tipo_conexion ?? 'no_definido') === key}>{label}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="label" for="fv_almacenamiento">Almacenamiento (kWh)</label>
        <input id="fv_almacenamiento" name="sistema_fotovoltaico.almacenamiento_kwh" type="number" min="0" step="0.01" class="input" value={fv?.almacenamiento_kwh ?? 0} />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="fv_observaciones">Observaciones del sistema</label>
        <textarea id="fv_observaciones" name="sistema_fotovoltaico.observaciones" rows="3" class="input" placeholder="Etapa del proyecto, condiciones de cubierta, equipos, garantías…">{fv?.observaciones ?? ''}</textarea>
      </div>
      <div class="sm:col-span-2 rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-xs text-slate-500">
        Si la empresa no cuenta ni proyecta un sistema fotovoltaico, deja el estado en “No aplica”.
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center justify-end gap-2">
    <a href={cancelHref} class="btn-secondary">Cancelar</a>
    <button type="submit" class="btn-primary">
      <Icon name="check" size={16} />
      {submitLabel}
    </button>
  </div>
</form>
