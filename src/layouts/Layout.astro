---
import '@/styles/global.css';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const pathname = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Dashboard', icon: 'dashboard' as const, match: (p: string) => p === '/' },
  {
    href: '/empresas',
    label: 'Empresas',
    icon: 'building' as const,
    match: (p: string) => p.startsWith('/empresas'),
  },
  {
    href: '/catalogos',
    label: 'Catálogos',
    icon: 'book' as const,
    match: (p: string) => p.startsWith('/catalogos'),
  },
  {
    href: '/biblioteca',
    label: 'Biblioteca',
    icon: 'brain' as const,
    match: (p: string) => p.startsWith('/biblioteca'),
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? 'Diagnóstico y reportes técnicos de eficiencia energética para MiPyMEs'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · EE Mentor</title>
  </head>
  <body class="min-h-screen">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:shadow-lg">
      Saltar al contenido
    </a>

    <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col bg-brand-950 text-white lg:flex">
      <div class="flex items-center gap-3 px-5 py-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/15 ring-1 ring-inset ring-brand-400/30">
          <Icon name="leaf" size={22} class="text-brand-300" />
        </span>
        <div>
          <p class="text-[15px] font-semibold tracking-tight text-white">EE Mentor</p>
          <p class="text-[10px] font-medium uppercase tracking-[0.16em] text-brand-400">Consultoría energética</p>
        </div>
      </div>

      <nav class="flex-1 space-y-1 px-3 py-2" aria-label="Navegación principal">
        {nav.map((item) => {
          const active = item.match(pathname);
          return (
            <a href={item.href} class={`nav-link ${active ? 'nav-link-active' : ''}`} aria-current={active ? 'page' : undefined}>
              <Icon name={item.icon} size={18} class={active ? 'text-brand-300' : 'text-slate-400'} />
              <span>{item.label}</span>
              {active && <span class="ml-auto h-1.5 w-1.5 rounded-full bg-brand-300" />}
            </a>
          );
        })}
      </nav>

      <div class="mx-3 mb-4 rounded-xl border border-white/10 bg-white/5 p-3.5">
        <div class="flex items-center gap-2 text-brand-300">
          <Icon name="database" size={15} />
          <span class="text-[11px] font-semibold uppercase tracking-wide">Almacenamiento local</span>
        </div>
        <p class="mt-1.5 text-[11px] leading-relaxed text-slate-400">
          Datos en archivos TOML y Markdown. Portable, respaldable y editable.
        </p>
        <a href="/biblioteca" class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-brand-300 hover:text-brand-200">
          Ver biblioteca <Icon name="arrowRight" size={12} />
        </a>
      </div>
    </aside>

    <div class="lg:pl-64">
      <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-slate-50/90 backdrop-blur lg:hidden">
        <div class="flex items-center justify-between px-4 py-3">
          <a href="/" class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-700 text-white">
              <Icon name="leaf" size={17} />
            </span>
            <span class="text-sm font-semibold text-slate-900">EE Mentor</span>
          </a>
          <details class="relative">
            <summary class="btn-secondary btn-sm cursor-pointer">
              <Icon name="menu" size={16} /> Menú
            </summary>
            <div class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
              {nav.map((item) => (
                <a href={item.href} class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
                  <Icon name={item.icon} size={16} class="text-slate-400" />
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </header>

      <main id="contenido" class:list={['mx-auto px-4 py-6 sm:px-6 lg:px-8 lg:py-8', wide ? 'max-w-[1600px]' : 'max-w-[1440px]']}>
        <slot />
        <footer class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-5 text-[11px] text-slate-400">
          <p>EE Mentor · Informes técnicos de eficiencia energética para MiPyMEs</p>
          <p class="flex items-center gap-1.5"><Icon name="lock" size={12} /> Los datos permanecen en este equipo</p>
        </footer>
      </main>
    </div>

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
