[secciones.envolvente]
puntaje = 1
observaciones = "El material constructivo del establecimiento, está compuesto de materiales livianos, con amplias aperturas entre el entretecho y vanos del establecimiento. Fuertemente favorecido por un clima cálido, por lo que promover la ventilación puede resultar clave para la operación de los equipos de frío. Sin embargo estas condiciones puedes ser contra indicativos para la preservación de frutas y verduras frescas."
ventanas = "deficiente"
puertas = "deficiente"
infiltraciones = "deficiente"
aislacion = "deficiente"

[secciones.gestion]
puntaje = 2
observaciones = "Cuenta con elementos que pueden sentar bases para una gestión energética más elaborada. Por razones económicas y el alto costo energético, hay una constante preocupación del performance del equipamiento del establecimiento. Se realizan monitoreo del estado de refrigeración de los artefactos y además seguimiento de los gastos energéticos. Se puede establecer a  futuro lineamientos básicos de gestión de la energía del local, para valorizar la propuesta de valor del negocio."
nivel = "basica"
monitoreo = true
responsable = "Propietaria"

