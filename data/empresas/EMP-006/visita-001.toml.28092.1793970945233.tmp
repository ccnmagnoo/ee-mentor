[secciones.iluminacion]
puntaje = 3
observaciones = "Cuenta con iluminación LED en todo el establecimiento, pero sin embargo no hay una traza de requerimientos lumínicos por zona, ya que cuenta con varios espacios destinados a uso de atención a clientela, como también para almacenamiento. Cada uno de ellos tiende a requerir distintos niveles de iluminación, que no es detallado en la entrevista."
